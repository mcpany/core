-        // Add edge from core to service
-        edges.push({
-            source: graph.core.id || 'core',
-            target: child.id,
-            status: child.status === 'NODE_STATUS_ERROR' ? 'blocked' : 'healthy',
-            hash: `edge-${graph.core.id}-${child.id}`
