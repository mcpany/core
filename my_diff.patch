-		// It will NEVER evaluate the switch for n < 10, n < 100, n < 1000, n < 10000, n < 100000, n < 1000000, n < 10000000!
-		// Because it's already caught by the fast path at the very beginning of the function!
-	}
-	for _, tt := range tests {
