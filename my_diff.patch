-            type: child.type?.toLowerCase().replace('node_type_', '') || 'service',
-            status: child.status === 'NODE_STATUS_ERROR' ? 'error' : (child.status === 'NODE_STATUS_INACTIVE' ? 'inactive' : 'active'),
