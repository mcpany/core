+# Shim Makefile to forward commands to server/Makefile and ui/Makefile
+# Proto TypeScript bindings are no longer generated here; use Bazel:
+#   bazel build //proto:ts_proto
+#   bazel build //ui:build
+.PHONY: all test lint build run clean gen gen-go-proto gen-gateway-proto gen-protoset prepare-proto clean-protos clean-gateway-protos update-screenshots
+
+# Variables
+GO = go
+GO_CMD := $(GO)
+ifdef INSIDE_DOCKER_CONTAINER
+GO_CMD := /usr/local/go/bin/go
+endif
+BUILD_DIR := $(abspath ./build)
+TOOL_INSTALL_DIR := $(BUILD_DIR)/env/bin
+PROTOC_INCLUDE_DIR := $(TOOL_INSTALL_DIR)/include
+GOOGLEAPIS_DIR := $(BUILD_DIR)/googleapis
+
+# Resolve bazelisk: prefer the locally installed copy, fall back to PATH.
+BAZELISK := $(shell if [ -f $(TOOL_INSTALL_DIR)/bazelisk ]; then echo $(TOOL_INSTALL_DIR)/bazelisk; else command -v bazelisk 2>/dev/null || echo bazelisk; fi)
+
+# Variables for protoc installation
+PROTOC_VERSION_URL := https://api.github.com/repos/protocolbuffers/protobuf/releases/latest
+PROTOC_DOWNLOAD_URL_BASE := https://github.com/protocolbuffers/protobuf/releases/download
+PROTOC_GEN_GO_VERSION ?= v1.36.11
+PROTOC_GEN_GO_GRPC_VERSION ?= v1.5.1
+GRPC_GATEWAY_VERSION ?= v2.27.3
+PROTOC_ZIP := protoc.zip
+PROTOC_VERSION := v33.1
+
+# Detect architecture for protoc
+UNAME_M := $(shell uname -m)
+PROTOC_ARCH := $(UNAME_M)
+ifeq ($(UNAME_M), aarch64)
+	PROTOC_ARCH := aarch_64
+endif
+
+PROTOC_GEN_GO := $(TOOL_INSTALL_DIR)/protoc-gen-go
+PROTOC_GEN_GO_GRPC := $(TOOL_INSTALL_DIR)/protoc-gen-go-grpc
+PROTOC_GEN_GRPC_GATEWAY := $(TOOL_INSTALL_DIR)/protoc-gen-grpc-gateway
+PROTOC_GEN_OPENAPIV2 := $(TOOL_INSTALL_DIR)/protoc-gen-openapiv2
+PROTOC_BIN := $(TOOL_INSTALL_DIR)/protoc
+
+# Targets that should run on both (or just server generally, but test on both)
+# Build all binaries and the UI via Bazel (single cache, hermetic, reproducible).
+all: gen
+	$(BAZELISK) build //server/cmd/server //server/cmd/worker //server/cmd/webhooks //ui:build
+
 prepare:
-	echo 'prepared'
+	$(MAKE) -C server prepare
+
+test: gen
+	$(MAKE) test-proto
+	$(BAZELISK) test //server/... //ui/...
+	$(MAKE) -C k8s test
+
+docker-build-all:
+	# Build OCI images via Bazel (hermetic, Dockerfile-free where possible).
+	$(BAZELISK) run //server/cmd/server:server_tarball
+	$(BAZELISK) run //ui:ui_tarball
+	# The http-echo-server and other auxiliary images still use Docker:
+	$(MAKE) -C server docker-build-http-echo
