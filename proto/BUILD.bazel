# gazelle:go_proto_compilers @rules_go//proto:go_proto
# gazelle:go_grpc_compilers @rules_go//proto:go_proto,@rules_go//proto:go_grpc_v2

# ---------------------------------------------------------------------------
# Well-known-type TypeScript bindings are generated at the repo root so that
# declare_file("google/protobuf/*.ts") produces files under
# bazel-out/.../bin/google/protobuf/ - the path ts-proto emits relative imports
# against (e.g. "../../../google/protobuf/duration" from proto/config/v1/).
# See //:gen_wkt_ts_files in BUILD.bazel.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Aggregate all generated TypeScript proto bindings consumed by the UI.
# ---------------------------------------------------------------------------
filegroup(
    name = "ts_proto",
    srcs = [
        "//:gen_wkt_ts_files",
        "//proto/api/v1:ts_proto_files",
        "//proto/bus:ts_proto_files",
        "//proto/config/v1:ts_proto_files",
    ],
    visibility = ["//visibility:public"],
)
