load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# gazelle:go_proto_compilers @rules_go//proto:go_proto
# gazelle:go_grpc_compilers @rules_go//proto:go_proto,@rules_go//proto:go_grpc_v2

copy_to_bin(
	name = "ts_proto_root_files",
	srcs = glob([
		"google/**/*.ts",
		"google/**/*.d.ts",
	], allow_empty = True),
	visibility = ["//visibility:public"],
)

filegroup(
	name = "ts_proto",
	srcs = [
		"//proto/api/v1:ts_proto_files",
		"//proto/bus:ts_proto_files",
		"//proto/config/v1:ts_proto_files",
		":ts_proto_root_files",
	],
	visibility = ["//visibility:public"],
)
