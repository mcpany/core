go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//server:go.mod")

# Disable proto generation for grpc-gateway so Gazelle uses pre-generated .pb.go
# files directly and does not try to resolve @googleapis (which is not visible
# from the grpc-gateway Go dep context in Bzlmod).
# Use build_file_generation=off to preserve the original BUILD files and apply
# our patch on top, which replaces the proto-based apiconfig target with one
# that uses the pre-generated apiconfig.pb.go source file directly.

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "debian_bookworm_slim",
    digest = "sha256:74d56e3931e0d5a1dd51f8c8a2466d21de84a271cd3b5a733b803aa91abf4421",
    image = "mirror.gcr.io/library/debian",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)

# Distroless Node.js 24 image used as the base for the UI container (vite preview).
oci.pull(
    name = "distroless_nodejs24",
    digest = "sha256:14d42e2511532589a7c7e01a753667a74fcc96266e137e8125006b87b0c32d0a",
    image = "gcr.io/distroless/nodejs24-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)

# Python 3.12-slim base image for Python-based container images (cowsay server, timeserver).
oci.pull(
    name = "python312_slim",
    digest = "sha256:fe778fce55d620e6b4b27885aa170579aed9b119ba45652e45a2e8bf48c22ede",
    image = "mirror.gcr.io/library/python",
    platforms = ["linux/amd64"],
)
use_repo(oci, "debian_bookworm_slim", "debian_bookworm_slim_linux_amd64", "debian_bookworm_slim_linux_arm64", "distroless_nodejs24", "distroless_nodejs24_linux_amd64", "distroless_nodejs24_linux_arm64", "python312_slim", "python312_slim_linux_amd64")

