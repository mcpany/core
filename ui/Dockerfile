# ---- deps stage: install all npm packages ----
FROM mirror.gcr.io/library/node:24-bookworm-slim AS deps
WORKDIR /app
COPY ui/package.json ui/package-lock.json* ui/.npmrc* ./
# Regenerate lockfile to avoid architecture/OS mismatch issues
RUN rm -f package-lock.json && \
    npm install --no-audit --registry=https://registry.npmjs.org/

# ---- builder stage: compile Vite SPA ----
FROM mirror.gcr.io/library/node:24-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY ui/ .
# Copy proto alongside UI so vite.config.ts resolves localProto = /app/proto
COPY proto/ /app/proto/

# ---- Generate TypeScript proto bindings ----
# Proto .ts files are NOT checked in (they are generated by Bazel at build
# time). Here we run protoc + protoc-gen-ts_proto (already installed via npm)
# to generate the same files so `npm run build` can compile the Vite SPA.
ARG PROTOC_VERSION=v33.1
RUN apt-get update -qq && apt-get install -y --no-install-recommends unzip curl && \
    rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64)  PROTOC_ARCH="linux-x86_64" ;; \
        aarch64) PROTOC_ARCH="linux-aarch_64" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac; \
    VER_NO_V="${PROTOC_VERSION#v}"; \
    curl -sSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/${PROTOC_VERSION}/protoc-${VER_NO_V}-${PROTOC_ARCH}.zip"; \
    unzip -q /tmp/protoc.zip -d /tmp/protoc; \
    install -m755 /tmp/protoc/bin/protoc /usr/local/bin/protoc; \
    cp -rn /tmp/protoc/include/google /usr/local/include/; \
    rm -rf /tmp/protoc /tmp/protoc.zip
RUN curl -sSL -o /tmp/googleapis.zip \
        https://github.com/googleapis/googleapis/archive/refs/heads/master.zip && \
    python3 -m zipfile -e /tmp/googleapis.zip /tmp && \
    mv /tmp/googleapis-master /tmp/googleapis && \
    rm /tmp/googleapis.zip
# Generate TypeScript bindings for all custom proto files.
# --proto_path=/app means "proto/config/v1/foo.proto" resolves from /app/proto/...
# --ts_proto_out=/app means output mirrors the same layout:
#   /app/proto/config/v1/foo.ts   (custom types)
#   /app/google/protobuf/*.ts     (well-known types, via relative imports)
RUN PLUGIN=/app/node_modules/.bin/protoc-gen-ts_proto && \
    find /app/proto -name "*.proto" \
        -not -path "/app/proto/google/*" \
        -not -path "/app/proto/third_party/*" \
        -not -path "/app/proto/examples/*" | \
    xargs protoc \
        --proto_path=/app \
        --proto_path=/usr/local/include \
        --proto_path=/tmp/googleapis \
        --plugin="protoc-gen-ts_proto=${PLUGIN}" \
        --ts_proto_out=/app \
        --ts_proto_opt=esModuleInterop=true,forceLong=long,useOptionals=messages,outputClientImpl=grpc-web
RUN npm run build

# ---- runner stage: serve via vite preview (handles proxy to backend) ----
# vite preview reads vite.config.ts at runtime, so BACKEND_URL is injected
# as a runtime env var rather than baked into the bundle.
FROM gcr.io/distroless/nodejs24-debian12:nonroot AS runner
WORKDIR /app

# Copy only what is needed to run `vite preview`:
#   node_modules  - vite binary + plugins (including proxy config deps)
#   dist/         - the pre-built static SPA
#   vite.config.ts - proxy rules (read by vite preview at startup)
#   index.html + package.json - required by the Vite runtime
COPY --from=deps    --chown=65532:65532 /app/node_modules   ./node_modules
COPY --from=builder --chown=65532:65532 /app/dist           ./dist
COPY --from=builder --chown=65532:65532 /app/vite.config.ts ./vite.config.ts
COPY --from=builder --chown=65532:65532 /app/index.html     ./index.html
COPY --from=builder --chown=65532:65532 /app/package.json   ./package.json

EXPOSE 3000

# BACKEND_URL is the runtime address of the mcpany backend.
# Override this env var when deploying (e.g. via Helm values or docker --env).
ENV BACKEND_URL=http://localhost:50050
ENV PORT=3000

# `vite preview` serves the pre-built dist/ and proxies API paths to BACKEND_URL
# as configured in the preview.proxy section of vite.config.ts.
CMD ["node_modules/.bin/vite", "preview", "--host", "0.0.0.0", "--port", "3000"]
