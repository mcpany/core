# Use official Playwright image directly to avoid dependency on intermediate CI images
# This ensures the build is self-contained and does not rely on missing registry images.
FROM mcr.microsoft.com/playwright:v1.58.0-jammy

WORKDIR /work/ui

# Copy package files first for caching
COPY ui/package.json ui/package-lock.json* ui/.npmrc* ./

# Install dependencies. Use npm install (not npm ci) since the lockfile may lag
# behind package.json during active development; npm install regenerates it.
RUN npm install --no-audit --registry=https://registry.npmjs.org/

# Copy the rest of the UI source code.
COPY ui/ .

# ---- Generate TypeScript proto bindings ----------------------------------
# Proto .ts files are NOT checked in (they are generated by Bazel at build
# time). Here we run protoc + protoc-gen-ts_proto (already installed via npm)
# to generate the same files so `npm run build` can compile the Vite SPA.
COPY proto/ /work/proto/

# Download the exact protoc version that matches the checked-in generated code.
ARG PROTOC_VERSION=v33.1
ARG TARGETARCH
RUN apt-get update -qq && apt-get install -y --no-install-recommends unzip curl && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64)  PROTOC_ARCH="linux-x86_64" ;; \
        aarch64) PROTOC_ARCH="linux-aarch_64" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac; \
    VER_NO_V="${PROTOC_VERSION#v}"; \
    curl -sSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/${PROTOC_VERSION}/protoc-${VER_NO_V}-${PROTOC_ARCH}.zip"; \
    unzip -q /tmp/protoc.zip -d /tmp/protoc; \
    install -m755 /tmp/protoc/bin/protoc /usr/local/bin/protoc; \
    cp -rn /tmp/protoc/include/google /usr/local/include/; \
    rm -rf /tmp/protoc /tmp/protoc.zip

# Generate our custom proto TS files.
# Proto path must include:
#   /work                       — our proto/ directory (imports like "proto/config/v1/...")
#   /usr/local/include          — protobuf well-known types (google/protobuf/...)
#   /tmp/googleapis             — Google API protos (google/api/annotations, etc.)
ARG GRPC_GATEWAY_VERSION=v2.27.3
RUN curl -sSL -o /tmp/googleapis.zip \
        https://github.com/googleapis/googleapis/archive/refs/heads/master.zip && \
    python3 -m zipfile -e /tmp/googleapis.zip /tmp && \
    mv /tmp/googleapis-master /tmp/googleapis && \
    rm /tmp/googleapis.zip

RUN PLUGIN=/work/ui/node_modules/.bin/protoc-gen-ts_proto && \
    find /work/proto -name "*.proto" \
        -not -path "/work/proto/google/*" \
        -not -path "/work/proto/third_party/*" | \
    xargs protoc \
        --proto_path=/work \
        --proto_path=/usr/local/include \
        --proto_path=/tmp/googleapis \
        --plugin="protoc-gen-ts_proto=${PLUGIN}" \
        --ts_proto_out=/work \
        --ts_proto_opt=esModuleInterop=true,forceLong=long,useOptionals=messages,outputClientImpl=grpc-web

# Generate well-known-type TS files (timestamp, duration, struct).
RUN PLUGIN=/work/ui/node_modules/.bin/protoc-gen-ts_proto && \
    protoc \
        --proto_path=/usr/local/include \
        --plugin="protoc-gen-ts_proto=${PLUGIN}" \
        --ts_proto_out=/work/proto \
        --ts_proto_opt=esModuleInterop=true,forceLong=long,useOptionals=messages,outputClientImpl=grpc-web \
        /usr/local/include/google/protobuf/duration.proto \
        /usr/local/include/google/protobuf/struct.proto \
        /usr/local/include/google/protobuf/timestamp.proto

# ---- Build the Vite SPA --------------------------------------------------
RUN ln -sf /work/ui/node_modules /work/proto/node_modules
ENV BACKEND_URL=http://localhost:50050
RUN npm run build

# Copy proto folder into ui so relative imports resolve correctly at runtime.
RUN cp -r /work/proto /work/ui/proto
# Update tsconfig to use local proto path (aligns with copied folder)
RUN sed -i 's|\.\./proto|proto|g' tsconfig.json
# Recursively chmod, but skip node_modules and symlinks to avoid errors
RUN find . \( -name node_modules -prune \) -o \( -type l -prune \) -o -exec chmod 777 {} +
# Ensure proto directory is also writable/accessible
RUN chmod -R 777 /work/proto

# Set up Playwright directories
RUN mkdir -p node_modules/.cache test-results playwright-report && \
    chmod -R 777 node_modules/.cache test-results playwright-report

# Default command (can be overridden)
CMD ["npx", "playwright", "test"]
