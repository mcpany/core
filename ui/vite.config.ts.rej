--- vite.config.ts
+++ vite.config.ts
@@ -10,13 +10,13 @@
 // Resolve the proto directory: in a Bazel build it is generated into
 // bazel-out and symlinked via bazel-bin; locally it lives one level up.
 const localProto = path.join(__dirname, "proto");
 // When @proto TS files are generated by Bazel (not checked in) they live under
 // bazel-bin/proto which is a symlink to the actual bazel-out directory.
 const bazelBinProto = path.join(__dirname, "../bazel-bin/proto");
 const rootProto = path.join(__dirname, "../proto");
 const protoPath = fs.existsSync(localProto)
   ? localProto
   : fs.existsSync(bazelBinProto)
     ? bazelBinProto
-    : rootProto;
+    : path.resolve(__dirname, "./src/mocks/proto/mock-proto.ts");
