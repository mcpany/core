load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//ui:@playwright/test/package_json.bzl", playwright_bin = "bin")
load("@npm//ui:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//ui:ts-proto/package_json.bzl", ts_proto_bin = "bin")
load("@npm//ui:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//ui:vite/package_json.bzl", vite_bin = "bin")
load("@npm//ui:vitest/package_json.bzl", vitest_bin = "bin")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_load", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//ui:playwright_tests.bzl", "define_playwright_tests")
load("//ui:vitest_tests.bzl", "define_vitest_tests")

npm_link_all_packages(name = "node_modules")

ts_proto_bin.protoc_gen_ts_proto_binary(
    name = "ts_proto_plugin",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(
        include = [
            "src/**",
            "index.html",
            "vite.config.ts",
            "package.json",
            "tsconfig.json",
            "postcss.config.mjs",
            "tailwind.config.ts",
            "components.json",
            "vitest.config.mts",
            "eslint.config.mjs",
            ".eslintrc.json",
            "playwright.config.ts",
            "playwright.screenshots.config.ts",
        ],
        allow_empty = True,
        exclude = ["node_modules/**"],
    ),
    visibility = ["//visibility:public"],
)

vite_bin.vite(
    name = "build",
    srcs = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = ["dist"],
)

define_vitest_tests(vitest_bin)

eslint_bin.eslint_test(
    name = "lint",
    args = ["src/"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
)

tsc_bin.tsc_test(
    name = "typecheck",
    args = ["--noEmit"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
)

define_playwright_tests()

pkg_files(
    name = "ui_dist_files",
    srcs = [":build"],
    prefix = "/app/dist",
)

# We wrap node_modules in a tarball to avoid path collision errors in pkg_files.
# pkg_tar handles the internal symlinks of aspect_rules_js more gracefully.
pkg_tar(
    name = "ui_node_modules_tar",
    srcs = [":node_modules"],
    package_dir = "/app/node_modules",
)

pkg_files(
    name = "ui_config_files",
    srcs = [
        "index.html",
        "package.json",
        "vite.config.ts",
    ],
    prefix = "/app",
)

pkg_tar(
    name = "ui_layer",
    srcs = [
        ":ui_config_files",
        ":ui_dist_files",
    ],
    deps = [
        ":ui_node_modules_tar",
    ],
)

oci_image(
    name = "ui_image",
    base = "@distroless_nodejs24",
    entrypoint = [
        "node",
        "/app/node_modules/.bin/vite",
        "preview",
        "--host",
        "0.0.0.0",
        "--port",
        "3000",
    ],
    env = {
        "BACKEND_URL": "http://localhost:50050",
        "PORT": "3000",
    },
    exposed_ports = ["3000/tcp"],
    tars = [":ui_layer"],
    workdir = "/app",
)

oci_load(
    name = "ui_tarball",
    image = ":ui_image",
    repo_tags = ["mcpany/ui:latest"],
    visibility = ["//visibility:public"],
)
