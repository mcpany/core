load("@npm//ui:next/package_json.bzl", next_bin = "bin")
load("@npm//ui:@playwright/test/package_json.bzl", playwright_bin = "bin")
load("@npm//ui:vitest/package_json.bzl", vitest_bin = "bin")
load("@npm//ui:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//ui:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("//ui:playwright_tests.bzl", "define_playwright_tests")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "srcs",
    srcs = glob(
        include = [
            "src/**",
            "next.config.ts",
            "package.json",
            "tsconfig.json",
            "postcss.config.mjs",
            "tailwind.config.ts",
            "components.json",
            "vitest.config.mts",
            "eslint.config.mjs",
            ".eslintrc.json",
            "playwright.config.ts",
            "playwright.screenshots.config.ts",
        ],
        exclude = ["node_modules/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "playwright_runtime_srcs",
    srcs = glob(
        include = [
            "src/**",
            "next.config.ts",
            "package.json",
            "tsconfig.json",
            "next-env.d.ts",
            "postcss.config.mjs",
            "tailwind.config.ts",
            "components.json",
            "vitest.config.mts",
            "eslint.config.mjs",
            ".eslintrc.json",
            ".npmrc",
            "playwright.config.ts",
            "playwright.screenshots.config.ts",
        ],
        exclude = [
            "node_modules/**",
            ".next/**",
            "playwright-report/**",
            "test-results/**",
            ".audit/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "playwright_support_srcs",
    srcs = glob(
        include = ["tests/**"],
        exclude = ["tests/**/*.spec.ts"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Build target
next_bin.next(
    name = "build",
    srcs = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
    args = ["build"],
    chdir = package_name(),
    out_dirs = [".next"],
)

next_bin.next_binary(
    name = "next_cli",
    data = [
        ":node_modules",
        ":playwright_runtime_srcs",
        ":playwright_support_srcs",
        "//proto:ts_proto",
    ],
)

playwright_bin.playwright_binary(
    name = "playwright_cli",
    data = [
        ":node_modules",
        ":playwright_runtime_srcs",
        ":playwright_support_srcs",
        "//proto:ts_proto",
    ],
)

# Vitest unit tests
vitest_bin.vitest_test(
    name = "vitest",
    args = ["run"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
)

# Linting
eslint_bin.eslint_test(
    name = "lint",
    args = [
        "src/",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
)

# Typecheck
tsc_bin.tsc_test(
    name = "typecheck",
    args = ["--noEmit"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":srcs",
        "//proto:ts_proto",
    ],
)

define_playwright_tests()
