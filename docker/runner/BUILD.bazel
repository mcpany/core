load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

pkg_tar(
    name = "bazelisk_tar",
    srcs = select({
        "@rules_go//go/platform:linux_amd64": ["@bazelisk_linux_amd64//file:bazelisk"],
        "@rules_go//go/platform:linux_arm64": ["@bazelisk_linux_arm64//file:bazelisk"],
    }),
    package_dir = "/usr/local/bin",
    mode = "0755",
)

oci_image(
    name = "runner_image",
    base = "@debian_bookworm_slim",
    tars = [":bazelisk_tar"],
)

oci_load(
    name = "runner_load",
    image = ":runner_image",
    repo_tags = ["mcp-any/runner:latest"],
)
