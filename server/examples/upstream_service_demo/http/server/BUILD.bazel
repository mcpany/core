load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "server_lib",
    srcs = ["time_server.go"],
    importpath = "github.com/mcpany/core/server/examples/upstream_service_demo/http/server",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = ["time_server_test.go"],
    embed = [":server_lib"],
    deps = ["@com_github_stretchr_testify//assert"],
)
