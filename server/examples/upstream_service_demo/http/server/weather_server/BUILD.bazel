load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "weather_server_lib",
    srcs = ["weather_server.go"],
    importpath = "github.com/mcpany/core/server/examples/upstream_service_demo/http/server/weather_server",
    visibility = ["//visibility:private"],
    deps = ["@com_github_gorilla_websocket//:websocket"],
)

go_binary(
    name = "weather_server",
    embed = [":weather_server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "weather_server_test",
    srcs = ["weather_server_test.go"],
    embed = [":weather_server_lib"],
    deps = [
        "@com_github_gorilla_websocket//:websocket",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
