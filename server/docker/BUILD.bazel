# Exposes Dockerfiles as Bazel targets for reference and CI tooling.
# Note: Dockerfile.server  hermetic OCI build at //server/cmd/server:server_tarball
# Note: Dockerfile.http-echo-server  hermetic OCI build at //server/tests/integration/cmd/mocks/http_echo_server:http_echo_server_tarball
#
# The images below are non-hermetic and must be built via `docker build` or the Makefile:
#   Dockerfile.bot      - Alpine + github-cli (requires apk network access)
#   Dockerfile.ci       - Alpine Go CI image (requires apk network access)
#   Dockerfile.dev      - Debian Go dev image (requires apt-get network access)
#   Dockerfile.everything - Node npm install at build time
#   Dockerfile.hydra    - Builds ory/hydra from GitHub source (requires git clone)
exports_files([
    "Dockerfile.bot",
    "Dockerfile.ci",
    "Dockerfile.dev",
    "Dockerfile.everything",
    "Dockerfile.http-echo-server",
    "Dockerfile.hydra",
    "Dockerfile.server",
])
