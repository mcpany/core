load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "telemetry",
    srcs = ["tracing.go"],
    importpath = "github.com/mcpany/core/server/pkg/telemetry",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/config/v1:config",
        "@io_opentelemetry_go_otel//:go_default_library",
        "@io_opentelemetry_go_otel//propagation:go_default_library",
        "@io_opentelemetry_go_otel//semconv/v1.26.0:go_default_library",
        "@io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp//:go_default_library",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp//:go_default_library",
        "@io_opentelemetry_go_otel_exporters_stdout_stdoutmetric//:go_default_library",
        "@io_opentelemetry_go_otel_exporters_stdout_stdouttrace//:go_default_library",
        "@io_opentelemetry_go_otel_sdk//resource:go_default_library",
        "@io_opentelemetry_go_otel_sdk//trace:go_default_library",
        "@io_opentelemetry_go_otel_sdk_metric//:go_default_library",
    ],
)

go_test(
    name = "telemetry_test",
    srcs = ["tracing_test.go"],
    embed = [":telemetry"],
    deps = [
        "//proto/config/v1:config",
        "@io_opentelemetry_go_otel//:go_default_library",
        "@org_golang_google_protobuf//proto",
    ],
)
