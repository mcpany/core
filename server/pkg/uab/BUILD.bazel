load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "uab",
    srcs = ["uab.go"],
    importpath = "github.com/mcpany/core/server/pkg/uab",
    visibility = ["//visibility:public"],
    deps = [
        "//server/pkg/storage",
        "@org_modernc_sqlite//:sqlite",
    ],
