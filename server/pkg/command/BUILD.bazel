load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "command",
    srcs = [
        "command.go",
        "docker_interface.go",
    ],
    importpath = "github.com/mcpany/core/server/pkg/command",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/config/v1:config",
        "//server/pkg/logging",
        "//server/pkg/validation",
        "@com_github_docker_docker//pkg/stdcopy:go_default_library",
        "@com_github_opencontainers_image_spec//specs-go/v1:go_default_library",
    ],
)

go_test(
    name = "command_test",
    srcs = [
        "command_coverage_test.go",
        "command_test.go",
        "docker_mock_test.go",
    ],
    embed = [":command"],
    deps = [
        "//proto/config/v1:config",
        "//server/pkg/validation",
        "@com_github_docker_docker//errdefs:go_default_library",
        "@com_github_opencontainers_image_spec//specs-go/v1:go_default_library",
        "@com_github_stretchr_testify//assert:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
    ],
)
