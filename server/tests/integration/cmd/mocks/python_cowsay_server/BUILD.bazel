load("@cowsay_server_deps//:requirements.bzl", "requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:packaging.bzl", "py_package")

exports_files(["requirements_lock.txt"])

py_binary(
    name = "cowsay_server_bin",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//visibility:public"],
    deps = [
        requirement("cowsay"),
        requirement("fastmcp"),
    ],
)

pkg_files(
    name = "cowsay_server_binary_files",
    srcs = [":cowsay_server_bin"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/app",
)

pkg_tar(
    name = "cowsay_server_layer",
    srcs = [":cowsay_server_bin"],
    include_runfiles = True,
    package_dir = "/app",
    strip_prefix = ".",
)

oci_image(
    name = "cowsay_server_image",
    base = "@python312_slim",
    entrypoint = [],
    tars = [":cowsay_server_layer"],
)

oci_load(
    name = "cowsay_server_tarball",
    image = ":cowsay_server_image",
    repo_tags = ["mcpany/e2e-cowsay-server:latest"],
    visibility = ["//visibility:public"],
)
