load("@rules_go//go:def.bzl", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("@timeserver_deps//:requirements.bzl", "requirement")

exports_files(["requirements_lock.txt"])

go_test(
    name = "examples_test",
    srcs = ["examples_test.go"],
    data = ["//server/examples:files"],
    tags = ["integration"],
    deps = [
        "//server/pkg/config",
        "@com_github_spf13_afero//:afero",
        "@com_github_stretchr_testify//require",
    ],
)

py_binary(
    name = "timeserver_bin",
    srcs = ["timeserver_patch/main.py"],
    main = "timeserver_patch/main.py",
    visibility = ["//visibility:public"],
    deps = [
        requirement("fastmcp"),
    ],
)

pkg_files(
    name = "timeserver_binary_files",
    srcs = [":timeserver_bin"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/app",
)

pkg_tar(
    name = "timeserver_layer",
    srcs = [":timeserver_binary_files"],
)

oci_image(
    name = "timeserver_image",
    base = "@python312_slim",
    entrypoint = ["/app/timeserver_bin"],
    tars = [":timeserver_layer"],
)

oci_load(
    name = "timeserver_tarball",
    image = ":timeserver_image",
    repo_tags = ["mcpany/e2e-timeserver:latest"],
    visibility = ["//visibility:public"],
)
