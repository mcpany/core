    await expect(row).toBeVisible({ timeout: 10000 });

    const clearBtn = page.getByRole('button', { name: 'Clear' });
    await expect(clearBtn).toBeVisible();
    await clearBtn.click();

    await expect(row).not.toBeVisible();
