+// ⚡ BOLT: Prevent rendering waste in DashboardGrid
+// Randomized Selection from Top 5 High-Impact Targets
+// The `renderWidget` function within `DashboardGrid` was causing O(N) unmemoized
+// rendering for every grid layout change or state update, dropping frames.
+// By extracting and memoizing this component, we decouple widget content rendering
+// from the grid's layout lifecycle, achieving near O(1) rendering cost during drag/resize.
+const MemoizedWidgetRenderer = memo(({ widget, server }: { widget: DashboardWidget; server?: typeof mockServers[0] }) => {
+  switch (widget.type) {
+    case 'server_status':
+      return server ? (
+        <ServerStatusWidget server={server} />
+      ) : (
+        <div className="flex h-full items-center justify-center text-muted-foreground">
+          Server not found
+        </div>
+      );
+    case 'active_connections':
+      return <ActiveConnectionsWidget />;
+    case 'error_rate':
+      return <ErrorRateWidget />;
+    case 'activity_log':
+      return <ActivityLogWidget />;
+    case 'resource_usage':
+      return <ResourceUsageWidget />;
+    case 'system_health':
+      return <SystemHealthWidget />;
+    case 'custom':
+      return (
+        <div className="flex h-full items-center justify-center text-muted-foreground">
+          Custom Widget: {widget.config?.title || widget.id}
+        </div>
+      );
+    default:
+      return null;
+  }
+});
+MemoizedWidgetRenderer.displayName = 'MemoizedWidgetRenderer';
